# Git LFS — assembled diagnosis artifacts under reports/
# Heavy workspaces (work/, harbor_runs/, trajectories/) stay gitignored.

reports/**/*.json filter=lfs diff=lfs merge=lfs -text
reports/**/*.html filter=lfs diff=lfs merge=lfs -text
reports/**/*.md filter=lfs diff=lfs merge=lfs -text
reports/**/*.txt filter=lfs diff=lfs merge=lfs -text

# Exception: keep experimental-ui sources as normal git objects if small
# (still LFS via *.html above — acceptable for multi-MB gallery)
